# ============================================================
# KED Global Logistics - Environment-Variablen
# Kopiere diese Datei nach .env.local und passe Werte an
# ============================================================

# TMS-Backend (NestJS)
TMS_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mock-Modus: true = Mock-Daten, false = echte TMS-Calls
NEXT_PUBLIC_USE_MOCKS=true

# JWT-Secret für Cookie-Signatur (mindestens 32 Zeichen)
# In Production: starkes, zufaelliges Secret verwenden!
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars

# Public URL der Website (für Sitemap, OG-Tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console Verification-Token
# (wird als <meta name="google-site-verification">-Tag gerendert)
GOOGLE_SITE_VERIFICATION=

# ============================================================
# Rate Limiting (Upstash Redis - kostenloser Tier reicht)
# Lege ein Konto auf upstash.com an, erstelle eine Redis-DB
# (Region eu-west-1) und kopiere die REST-Credentials hier hin.
# Wenn nicht gesetzt: Rate-Limiting ist deaktiviert
# (Requests werden nicht blockiert, nur ein Warning geloggt).
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
