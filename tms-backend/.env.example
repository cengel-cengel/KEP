# ============================================================
# TMS Backend - Environment Variables
# Kopiere diese Datei nach .env und fuelle die Werte aus.
# In Railway/Produktion: in den Service-Settings setzen.
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Datenbank (PostgreSQL) ---
# Lokal:        postgresql://tms_user:tms_password@localhost:5432/tms_db
# Railway:      wird automatisch via DATABASE_URL injected
DATABASE_URL=postgresql://tms_user:tms_password@localhost:5432/tms_db

# --- Redis (Bull Job-Queue) ---
# Lokal:        REDIS_HOST=localhost / REDIS_PORT=6379
# Railway:      Redis-Plugin liefert REDIS_URL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth (JWT) ---
# JWT_SECRET muss mind. 32 Zeichen lang sein.
# Generieren: openssl rand -hex 32
JWT_SECRET=__bitte_oeffnen_und_setzen__bitte_mindestens_32_zeichen__
JWT_EXPIRES_IN=8h

# --- Cron-Auth (R3-E) ---
# Schützt /admin/cron/* Endpoints. Railway-Cron schickt
# Header X-Cron-Secret: $CRON_SECRET. Fail-closed wenn nicht
# gesetzt → 503 ServiceUnavailable.
# Generieren: openssl rand -hex 32
# Siehe docs/railway-cron.md.
CRON_SECRET=

# --- CORS / Frontend-URLs ---
# Komma-separiert fuer mehrere Origins
# Lokal:        leer lassen (Default localhost:3000 + 5173)
# Production:   z.B. https://tms.ked-global-logistics.de,https://tms-frontend.up.railway.app
FRONTEND_URL=

# --- Throttler ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Swagger ---
# In Production standardmaessig aus. Auf "true" setzen, wenn /docs
# fuer die GF-Demo-Phase erreichbar bleiben soll.
ENABLE_SWAGGER=true

# --- Optional: AWS (S3 + SES) ---
# Nur noetig, wenn Document-Upload / E-Mail-Versand genutzt wird.
# Fuer GF-Demo nicht zwingend - dann leer lassen.
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM=

# --- Optional: Puppeteer (PDF-Generation) ---
# Wenn Chromium nicht im Image: Skip-Download und Pfad setzen
# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
