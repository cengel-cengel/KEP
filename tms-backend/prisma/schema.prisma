  created_at                  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime            @default(now()) @db.Timestamptz(6)
  nv_tour_gebiet              nv_tour_gebiete     @relation("nv_stamm_touren_tour_gebiet", fields: [nv_tour_gebiet_id], references: [id], onDelete: Cascade)
  default_subunternehmer      nv_subunternehmer?  @relation("nv_stamm_touren_default_sub", fields: [default_subunternehmer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stamm_kunden                nv_stamm_kunden[]   @relation("nv_stamm_kunden_tour")
  nv_touren                   nv_touren[]         @relation("nv_touren_stamm_tour")

  @@index([nv_tour_gebiet_id])
  @@index([default_subunternehmer_id])
}

model nv_stamm_kunden {
  id                          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nv_stamm_tour_id            String           @db.Uuid
  customer_id                 String           @db.Uuid
  standard_position           Int              @default(0)
  standard_servicezeit_min    Int?
  routing_klasse              String?          @db.VarChar(30)
  notizen                     String?
  aktiv                       Boolean          @default(true)
  created_at                  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime         @default(now()) @db.Timestamptz(6)
  nv_stamm_tour               nv_stamm_touren  @relation("nv_stamm_kunden_tour", fields: [nv_stamm_tour_id], references: [id], onDelete: Cascade)
  customer                    customers        @relation("nv_stamm_kunden_customer", fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([nv_stamm_tour_id, customer_id], map: "nv_stamm_kunden_unique")
  @@index([nv_stamm_tour_id, standard_position])
  @@index([customer_id])
}

model nv_touren {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nv_stamm_tour_id         String?             @db.Uuid
  datum                    DateTime            @db.Date
  status                   String              @default("PLANNING") @db.VarChar(20)
  subunternehmer_id        String?             @db.Uuid
  start_zeit               DateTime?           @db.Time(6)
  end_zeit                 DateTime?           @db.Time(6)
  fahrzeug_typ             String?             @db.VarChar(20)
  notizen                  String?
  fahrer_kosten_eur        Decimal?            @db.Decimal(10, 2)
  fahrzeug_kosten_eur      Decimal?            @db.Decimal(10, 2)
  kraftstoff_kosten_eur    Decimal?            @db.Decimal(10, 2)
  dispo_kosten_eur         Decimal?            @db.Decimal(10, 2)
  sonstige_kosten_eur      Decimal?            @db.Decimal(10, 2)
  total_kosten_eur         Decimal?            @default(dbgenerated()) @db.Decimal(10, 2)
  kosten_modus             String              @default("TARIF") @db.VarChar(20)
  angefahrene_km           Decimal?            @db.Decimal(10, 2)
  stunden_geleistet        Decimal?            @db.Decimal(10, 2)
  geplante_km              Decimal?            @db.Decimal(10, 2)
  km_calculated_at         DateTime?           @db.Timestamptz(6)
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  updated_at               DateTime            @default(now()) @db.Timestamptz(6)
  nv_stamm_tour            nv_stamm_touren?    @relation("nv_touren_stamm_tour", fields: [nv_stamm_tour_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  subunternehmer           nv_subunternehmer?  @relation("nv_touren_sub", fields: [subunternehmer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stops                    nv_tour_stops[]     @relation("nv_tour_stops_tour")
  cost_components          shipment_cost_components[]

  @@index([datum, status])
  @@index([nv_stamm_tour_id, datum])
  @@index([subunternehmer_id])
}

model shipment_cost_components {
  id                          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id                 String     @db.Uuid
  nv_tour_id                  String?    @db.Uuid
  phase                       String     @db.VarChar(20)
  stop_anteil_eur             Decimal?   @db.Decimal(10, 2)
  zeit_anteil_eur             Decimal?   @db.Decimal(10, 2)
  routing_anteil_eur          Decimal?   @db.Decimal(10, 2)
  kapazitaet_anteil_eur       Decimal?   @db.Decimal(10, 2)
  total_eur                   Decimal?   @default(dbgenerated()) @db.Decimal(10, 2)
  faktoren                    Json?
  tour_total_kosten_eur       Decimal?   @db.Decimal(10, 2)
  tour_gesamt_stops           Int?
  tour_gesamt_minuten         Int?
  computed_at                 DateTime   @default(now()) @db.Timestamptz(6)
  shipment                    shipments  @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  nv_tour                     nv_touren? @relation(fields: [nv_tour_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([shipment_id, phase, nv_tour_id], map: "shipment_cost_components_unique")
  @@index([shipment_id])
  @@index([nv_tour_id])
  @@index([phase])
}

model nv_tour_stops {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nv_tour_id             String      @db.Uuid
  shipment_id            String      @db.Uuid
  position               Int
  stop_type              String      @default("PICKUP") @db.VarChar(20)
  servicezeit_min        Int?
  routing_klasse         String?     @db.VarChar(30)
  service_zuschlaege     Json?
  status                 String      @default("PLANNED") @db.VarChar(20)
  ankunft_zeit           DateTime?   @db.Timestamptz(6)
  abfahrt_zeit           DateTime?   @db.Timestamptz(6)
  notizen                String?
  created_at             DateTime    @default(now()) @db.Timestamptz(6)
  updated_at             DateTime    @default(now()) @db.Timestamptz(6)
  nv_tour                nv_touren   @relation("nv_tour_stops_tour", fields: [nv_tour_id], references: [id], onDelete: Cascade)
  shipment               shipments   @relation("nv_tour_stops_shipment", fields: [shipment_id], references: [id], onDelete: Cascade)

  @@unique([nv_tour_id, shipment_id], map: "nv_tour_stops_unique_shipment")
  @@unique([nv_tour_id, position], map: "nv_tour_stops_unique_position")
  @@index([nv_tour_id, position])
  @@index([shipment_id])
}
