generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model addresses {
  id                                                 String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id                                        String?      @db.Uuid
  type                                               address_type @default(delivery)
  name                                               String       @db.VarChar(200)
  name2                                              String?      @db.VarChar(200)
  street                                             String       @db.VarChar(200)
  zip                                                String       @db.VarChar(10)
  city                                               String       @db.VarChar(100)
  country_code                                       String       @default("DE") @db.Char(2)
  lat                                                Decimal?     @db.Decimal(10, 7)
  lng                                                Decimal?     @db.Decimal(10, 7)
  contact_name                                       String?      @db.VarChar(100)
  contact_phone                                      String?      @db.VarChar(30)
  contact_email                                      String?      @db.VarChar(200)
  opening_hours                                      Json?
  notes                                              String?
  is_active                                          Boolean      @default(true)
  created_at                                         DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime     @default(now()) @db.Timestamptz(6)
  customers                                          customers?   @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  shipments_shipments_delivery_address_idToaddresses shipments[]  @relation("shipments_delivery_address_idToaddresses")
  shipments_shipments_loading_address_idToaddresses  shipments[]  @relation("shipments_loading_address_idToaddresses")

  @@index([city(ops: raw("gin_trgm_ops"))], map: "idx_addresses_city", type: Gin)
  @@index([country_code], map: "idx_addresses_country")
  @@index([customer_id], map: "idx_addresses_customer")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_addresses_name", type: Gin)
  @@index([zip], map: "idx_addresses_zip")
}

model audit_log {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  table_name String       @db.VarChar(100)
  record_id  String       @db.Uuid
  action     audit_action
  old_values Json?
  new_values Json?
  user_id    String?      @db.Uuid
  user_ip    String?      @db.Inet
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  users      users?       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_log_created")
  @@index([table_name, record_id], map: "idx_audit_log_table_record")
  @@index([user_id], map: "idx_audit_log_user")
}

model condition_rates {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  condition_id String     @db.Uuid
  from_value   Decimal    @db.Decimal(10, 3)
  to_value     Decimal    @db.Decimal(10, 3)
  rate         Decimal    @db.Decimal(10, 4)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  conditions   conditions @relation(fields: [condition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([condition_id], map: "idx_condition_rates_condition")
}

model conditions {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id        String            @db.Uuid
  name               String            @db.VarChar(100)
  valid_from         DateTime          @db.Date
  valid_to           DateTime?         @db.Date
  basis              condition_basis   @default(ldm)
  country_from       String?           @db.Char(2)
  country_to         String?           @db.Char(2)
  zip_prefix_from    String?           @db.VarChar(5)
  zip_prefix_to      String?           @db.VarChar(5)
  min_charge         Decimal?          @default(0) @db.Decimal(10, 2)
  fuel_surcharge_pct Decimal?          @default(0) @db.Decimal(5, 2)
  is_active          Boolean           @default(true)
  created_by         String?           @db.Uuid
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @db.Timestamptz(6)
  condition_rates    condition_rates[]
  users              users?            @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers          customers         @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shipments          shipments[]

  @@index([customer_id], map: "idx_conditions_customer")
  @@index([valid_from, valid_to], map: "idx_conditions_validity")
}

model customers {
  id                    String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_number       String             @unique @db.VarChar(20)
  name                  String             @db.VarChar(200)
  name2                 String?            @db.VarChar(200)
  vat_id                String?            @db.VarChar(30)
  payment_term_days     Int                @default(30)
  credit_limit          Decimal?           @db.Decimal(12, 2)
  datev_account         String?            @db.VarChar(10)
  default_incoterm      String?            @db.VarChar(10)
  default_freight_payer freight_payer      @default(sender)
  invoice_email         String?            @db.VarChar(200)
  edi_partner_id        String?            @db.VarChar(50)
  min_contribution_pct  Decimal?           @default(10.00) @db.Decimal(5, 2)
  notes                 String?
  is_active             Boolean            @default(true)
  created_by            String?            @db.Uuid
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @db.Timestamptz(6)
  addresses             addresses[]
  conditions            conditions[]
  customer_tariffs      customer_tariffs[]
  users                 users?             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices              invoices[]
  pricing_rules         pricing_rules[]
  shipments             shipments[]
  nv_stamm_kunden       nv_stamm_kunden[]  @relation("nv_stamm_kunden_customer")

  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_customers_name", type: Gin)
  @@index([customer_number], map: "idx_customers_number")
}

model invoice_items {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoice_id  String     @db.Uuid
  shipment_id String?    @db.Uuid
  description String
  quantity    Decimal    @default(1) @db.Decimal(10, 3)
  unit        String     @default("flat") @db.VarChar(20)
  unit_price  Decimal    @db.Decimal(12, 4)
  total_price Decimal    @db.Decimal(12, 2)
  position    Int        @default(1) @db.SmallInt
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  invoices    invoices   @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shipments   shipments? @relation(fields: [shipment_id], references: [id], onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_items_invoice")
  @@index([shipment_id], map: "idx_invoice_items_shipment")
}

model invoices {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoice_number      String          @unique @db.VarChar(30)
  customer_id         String          @db.Uuid
  invoice_date        DateTime        @db.Date
  due_date            DateTime        @db.Date
  status              invoice_status  @default(draft)
  net_amount          Decimal         @default(0) @db.Decimal(12, 2)
  vat_rate            Decimal         @default(19.00) @db.Decimal(5, 2)
  vat_amount          Decimal         @default(0) @db.Decimal(12, 2)
  gross_amount        Decimal         @default(0) @db.Decimal(12, 2)
  payment_received_at DateTime?       @db.Timestamptz(6)
  datev_exported_at   DateTime?       @db.Timestamptz(6)
  pdf_s3_key          String?         @db.VarChar(500)
  notes               String?
  created_by          String          @db.Uuid
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)
  invoice_items       invoice_items[]
  users               users           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers           customers       @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "idx_invoices_customer")
  @@index([invoice_date], map: "idx_invoices_date")
  @@index([status], map: "idx_invoices_status")
}

model shipment_events {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shipment_id String          @db.Uuid
  status      shipment_status
  location    String?         @db.VarChar(200)
  note        String?
  created_by  String?         @db.Uuid
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  users       users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipments   shipments       @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shipment_id], map: "idx_shipment_events_shipment")
}

model shipments {
  id                                                 String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shipment_number                                    String                     @unique @db.VarChar(30)
  customer_id                                        String?                    @db.Uuid
  customer_ref                                       String?                    @db.VarChar(50)
  status                                             shipment_status            @default(new)
  loading_address_id                                 String                     @db.Uuid
  delivery_address_id                                String                     @db.Uuid
  loading_date                                       DateTime                   @db.Date
  loading_time_from                                  DateTime?                  @db.Time(6)
  loading_time_to                                    DateTime?                  @db.Time(6)
  delivery_date                                      DateTime                   @db.Date
  delivery_time_from                                 DateTime?                  @db.Time(6)
  delivery_time_to                                   DateTime?                  @db.Time(6)
  package_type                                       package_type               @default(pallet_euro)
  package_count                                      Int                        @default(1)
  weight_kg                                          Decimal                    @db.Decimal(10, 2)
  ldm                                                Decimal?                   @db.Decimal(6, 2)
  volume_m3                                          Decimal?                   @db.Decimal(8, 3)
  length_cm                                          Int?
  width_cm                                           Int?
  height_cm                                          Int?
  is_hazmat                                          Boolean                    @default(false)
  hazmat_class                                       String?                    @db.VarChar(10)
  hazmat_un_number                                   String?                    @db.VarChar(10)
  hazmat_packing_group                               String?                    @db.VarChar(5)
  hazmat_description                                 String?
  incoterm                                           String?                    @db.VarChar(10)
  freight_payer                                      freight_payer              @default(sender)
  condition_id                                       String?                    @db.Uuid
  tour_id                                            String?                    @db.Uuid
  tour_position                                      Int?                       @db.SmallInt
  freight_revenue                                    Decimal?                   @db.Decimal(12, 2)
  freight_cost                                       Decimal?                   @db.Decimal(12, 2)
  contribution_margin                                Decimal?                   @db.Decimal(12, 2)
  cm_percent                                         Decimal?                   @db.Decimal(5, 2)
  comment                                            String?
  customer_note                                      String?
  delivery_note_number                               String?                    @db.VarChar(50)
  edi_source                                         String?                    @db.VarChar(50)
  edi_reference                                      String?                    @db.VarChar(100)
  last_status_update                                 DateTime?                  @db.Timestamptz(6)
  delivered_at                                       DateTime?                  @db.Timestamptz(6)
  pod_image_s3_key                                   String?                    @db.VarChar(500)
  created_by                                         String                     @db.Uuid
  created_at                                         DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime                   @default(now()) @db.Timestamptz(6)
  deleted_at                                         DateTime?                  @db.Timestamptz(6)
  transport_type                                     String                     @default("DIREKT") @db.VarChar(20)
  relation_id                                        String?                    @db.Uuid
  business_partner_id                                String?                    @db.Uuid
  chargeable_weight                                  Decimal?                   @db.Decimal(10, 2)
  cbm                                                Decimal?                   @db.Decimal(8, 3)
  volume_weight_cbm                                  Decimal?                   @db.Decimal(10, 2)
  volume_weight_ldm                                  Decimal?                   @db.Decimal(10, 2)
  fpg_method                                         String?                    @db.VarChar(20)
  pre_carriage_cost                                  Decimal?                   @default(0) @db.Decimal(10, 2)
  main_carriage_cost                                 Decimal?                   @default(0) @db.Decimal(10, 2)
  on_carriage_cost                                   Decimal?                   @default(0) @db.Decimal(10, 2)
  total_cost                                         Decimal?                   @default(0) @db.Decimal(10, 2)
  inbound_routing_id                                 String?                    @db.Uuid
  outbound_routing_id                                String?                    @db.Uuid
  inbound_delivery_type                              String?                    @db.VarChar(20)
  outbound_delivery_type                             String?                    @db.VarChar(20)
  inbound_partner_name                               String?                    @db.VarChar(200)
  outbound_partner_name                              String?                    @db.VarChar(200)
  has_active_lock                                    Boolean?                   @default(false)
  lock_types                                         String?                    @db.VarChar(200)
  advisory_required                                  Boolean?                   @default(false)
  advisory_status                                    String?                    @default("none") @db.VarChar(20)
  last_event_type                                    String?                    @db.VarChar(30)
  last_event_at                                      DateTime?                  @db.Timestamptz(6)
  customer_tariff_id                                 String?                    @db.Uuid
  calculated_revenue                                 Decimal?                   @db.Decimal(10, 2)
  daily_price                                        Decimal?                   @db.Decimal(10, 2)
  partner_on_carriage_cost                           Decimal?                   @default(0) @db.Decimal(10, 2)
  has_nv_disposition                                 Boolean?                   @default(false)
  has_damage_report                                  Boolean?                   @default(false)
  has_return                                         Boolean?                   @default(false)
  return_status                                      String?                    @db.VarChar(20)
  advisories                                         advisories[]
  claims                                             claims[]
  damage_reports                                     damage_reports[]
  driver_deliveries                                 driver_deliveries[]
  driver_problems                                   driver_problems[]
  hall_check_items_entries                           hall_check_items[]
  hall_movements_entries                             hall_movements[]
  hall_stock_entries                                 hall_stock[]
  invoice_items                                      invoice_items[]
  loading_plan_draft_items                           loading_plan_draft_items[]
  nv_dispositions                                    nv_dispositions[]
  pre_carriage_shipments                             pre_carriage_shipments[]
  returns                                            returns[]
  shipment_events                                    shipment_events[]
  shipment_locks                                     shipment_locks[]
  shipment_package_items                             shipment_package_items[]
  shipment_status_events                             shipment_status_events[]
  business_partner                                   business_partners?         @relation(fields: [business_partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conditions                                         conditions?                @relation(fields: [condition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                              users                      @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                                          customers?                 @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_tariff                                    customer_tariffs?          @relation(fields: [customer_tariff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addresses_shipments_delivery_address_idToaddresses addresses                  @relation("shipments_delivery_address_idToaddresses", fields: [delivery_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inbound_routing                                    routing_rules?             @relation("shipments_inbound_routing", fields: [inbound_routing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addresses_shipments_loading_address_idToaddresses  addresses                  @relation("shipments_loading_address_idToaddresses", fields: [loading_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outbound_routing                                   routing_rules?             @relation("shipments_outbound_routing", fields: [outbound_routing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  relation                                           relations?                 @relation("shipments_relation", fields: [relation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tours                                              tours?                     @relation(fields: [tour_id], references: [id], onUpdate: NoAction)
  surplus_items                                      surplus_items[]
  nv_tour_stops                                      nv_tour_stops[]            @relation("nv_tour_stops_shipment")
  cost_components                                    shipment_cost_components[]

  @@index([customer_id], map: "idx_shipments_customer")
  @@index([customer_ref], map: "idx_shipments_customer_ref")
  @@index([delivery_date], map: "idx_shipments_delivery_date")
  @@index([loading_date], map: "idx_shipments_loading_date")
  @@index([id], map: "idx_shipments_not_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([shipment_number], map: "idx_shipments_number")
  @@index([status], map: "idx_shipments_status")
  @@index([tour_id], map: "idx_shipments_tour")
  @@index([business_partner_id], map: "idx_shipments_business_partner")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shipment_package_items {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shipment_id   String       @db.Uuid
  line_index    Int
  package_type  package_type @default(pallet_euro)
  quantity      Int          @default(1)
  length_cm     Int
  width_cm      Int
  height_cm     Int
  weight_kg     Decimal      @db.Decimal(10, 2)
  stackable     Boolean      @default(true)
  pos_x_cm      Int?
  pos_y_cm      Int?
  pos_z_cm      Int?
  rotation_deg  Int          @default(0)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  shipments     shipments    @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shipment_id, line_index], map: "uq_shipment_package_line")
  @@index([shipment_id], map: "idx_shipment_package_items_shipment")
}

// Driver-App: Zustellungen & Probleme (Sprint 15)
model driver_deliveries {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id       String    @db.Uuid
  tour_id           String    @db.Uuid
  driver_name      String?
  recipient_name   String    @db.VarChar(100)
  signature_base64 String?
  photo_base64     String?
  delivered_at     DateTime  @db.Timestamptz(6)
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  shipments        shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tours            tours @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shipment_id], map: "idx_driver_deliveries_shipment")
  @@index([tour_id], map: "idx_driver_deliveries_tour")
}

model driver_problems {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id    String   @db.Uuid
  tour_id        String   @db.Uuid
  problem_type   String   @db.VarChar(30)
  notes          String?
  photo_base64   String?
  reported_at    DateTime? @default(now()) @db.Timestamptz(6)

  shipments      shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tours          tours @relation(fields: [tour_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shipment_id], map: "idx_driver_problems_shipment")
  @@index([tour_id], map: "idx_driver_problems_tour")
}

model nv_dispositions {
  id                                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id                              String    @db.Uuid
  problem_type                             String    @db.VarChar(30)
  disposition_type                         String?   @db.VarChar(20)
  driver_notes                             String?
  driver_photo_base64                      String?
  reported_at                              DateTime? @default(now()) @db.Timestamptz(6)
  retry_date                               DateTime? @db.Date
  retry_time_from                          DateTime? @db.Time(6)
  retry_time_to                            DateTime? @db.Time(6)
  return_cost_eur                          Decimal?  @default(0) @db.Decimal(10, 2)
  return_cost_bearer                       String?   @db.VarChar(20)
  storage_start_date                       DateTime? @db.Date
  storage_daily_rate                       Decimal?  @db.Decimal(10, 2)
  notes                                    String?
  status                                   String?   @default("open") @db.VarChar(20)
  created_by                               String?   @db.Uuid
  resolved_by                              String?   @db.Uuid
  resolved_at                              DateTime? @db.Timestamptz(6)
  created_at                               DateTime? @default(now()) @db.Timestamptz(6)
  users_nv_dispositions_created_byTousers  users?    @relation("nv_dispositions_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_nv_dispositions_resolved_byTousers users?    @relation("nv_dispositions_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipments                                shipments @relation(fields: [shipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returns                                  returns[]
}

model damage_reports {
  id                                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id                             String    @db.Uuid
  damage_type                             String    @db.VarChar(20)
  damage_cause                            String?   @db.VarChar(20)
  damage_description                      String
  damage_value_eur                        Decimal?  @db.Decimal(10, 2)
  photo_base64_1                          String?
  photo_base64_2                          String?
  photo_base64_3                          String?
  reported_by_driver                      Boolean?  @default(false)
  reported_at                             DateTime? @default(now()) @db.Timestamptz(6)
  liability_party                         String?   @db.VarChar(20)
  insurance_claim                         Boolean?  @default(false)
  insurance_ref                           String?   @db.VarChar(100)
  status                                  String?   @default("open") @db.VarChar(20)
  resolution_notes                        String?
  created_by                              String?   @db.Uuid
  resolved_by                             String?   @db.Uuid
  resolved_at                             DateTime? @db.Timestamptz(6)
  created_at                              DateTime? @default(now()) @db.Timestamptz(6)
  claims                                  claims[]
  users_damage_reports_created_byTousers  users?    @relation("damage_reports_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_damage_reports_resolved_byTousers users?    @relation("damage_reports_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipments                               shipments @relation(fields: [shipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model claims {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id      String          @db.Uuid
  damage_report_id String?         @db.Uuid
  claim_type       String          @db.VarChar(20)
  claim_against    String          @db.VarChar(20)
  claim_amount_eur Decimal?        @db.Decimal(10, 2)
  status           String?         @default("open") @db.VarChar(20)
  partner_ref      String?         @db.VarChar(100)
  deadline_date    DateTime?       @db.Date
  notes            String?
  created_by       String?         @db.Uuid
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  users            users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  damage_report    damage_reports? @relation(fields: [damage_report_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipments        shipments       @relation(fields: [shipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model returns {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id       String           @db.Uuid
  nv_disposition_id String?          @db.Uuid
  return_reason     String           @db.VarChar(30)
  return_type       String           @db.VarChar(20)
  return_cost_eur   Decimal?         @default(0) @db.Decimal(10, 2)
  cost_bearer       String?          @db.VarChar(20)
